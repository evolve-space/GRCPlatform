# Plantilla de variables para PRODUCCIÓN (docker-compose.prod.yml).
# Copia este archivo a .env.prod y sustituye TODOS los valores.
# NUNCA commitear .env.prod (ya excluido en .gitignore).

# Dominio público donde se sirve la aplicación (usado por Nginx y por CORS).
DOMAIN=tu-dominio-real.example.com

# Base de datos — usuario/contraseña reales, nunca los de desarrollo.
POSTGRES_USER=cambia-este-usuario
POSTGRES_PASSWORD=cambia-esta-contrasena-por-una-generada-aleatoriamente
POSTGRES_DB=grcplatform

# Backend — genera un valor propio con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ENVIRONMENT=production exige SECRET_KEY de al menos 32 caracteres (ver
# app/core/config.py) y rechaza el arranque si no se cumple.
SECRET_KEY=cambia-esta-clave-por-una-generada-aleatoriamente-de-32-caracteres-o-mas
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_EVIDENCE_FILE_SIZE_MB=20

# Servidor MCP — token de integración real, creado ya con la API en marcha
# (POST /api/v1/integration-tokens, rol Admin). No tiene valor por defecto:
# el servidor MCP no arranca sin él.
GRC_MCP_TOKEN=cambia-esto-por-un-integration-token-real-grc_...
