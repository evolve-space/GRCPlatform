# Base de datos
POSTGRES_USER=grcplatform
POSTGRES_PASSWORD=grcplatform
POSTGRES_DB=grcplatform
POSTGRES_PORT=5433

# Backend
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# Genera un valor propio, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambia-esta-clave-por-una-generada-aleatoriamente
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Almacenamiento de evidencias (ruta dentro del contenedor del backend)
EVIDENCE_STORAGE_PATH=storage/evidence
MAX_EVIDENCE_FILE_SIZE_MB=20

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000

# Servidor MCP
# Token de integración real: créalo con POST /api/v1/integration-tokens
# (rol Admin) y pega aquí el valor "token" de la respuesta — solo se
# muestra una vez, GRCPlatform nunca guarda ni puede recuperar el secreto.
MCP_PORT=8001
GRC_MCP_TOKEN=cambia-esto-por-un-integration-token-real-grc_...
MCP_TRANSPORT=streamable-http
MCP_HTTP_PORT=8001
