# Copia este archivo como .env para ejecutar el backend localmente (fuera de Docker).
DATABASE_URL=postgresql+psycopg://grcplatform:grcplatform@localhost:5433/grcplatform
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# Genera un valor propio, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambia-esta-clave-por-una-generada-aleatoriamente
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Almacenamiento de evidencias (ruta relativa al directorio del backend)
EVIDENCE_STORAGE_PATH=storage/evidence
MAX_EVIDENCE_FILE_SIZE_MB=20
