# Plantilla de Nginx para producción (Fase 10). Las variables ${DOMAIN} se
# sustituyen automáticamente al arrancar el contenedor (imagen oficial
# nginx:1.27-alpine: todo archivo en /etc/nginx/templates/*.template pasa
# por `envsubst` y se escribe en /etc/nginx/conf.d/ sin script propio).
#
# IMPORTANTE: las variables propias de Nginx que también empiezan por "$"
# ($host, $remote_addr, $scheme, etc.) NO se tocan, porque `envsubst` en la
# imagen oficial solo sustituye nombres que existen como variable de entorno
# real del contenedor — $host/$scheme/etc. no lo son, así que llegan
# intactas a Nginx. Por eso DOMAIN se escribe en mayúsculas: para no
# coincidir nunca por accidente con una variable de Nginx (siempre en
# minúsculas).

upstream backend_api {
    server backend:8000;
}

# Redirección HTTP -> HTTPS, y ruta para la validación ACME de Let's Encrypt
# (ver docs/DEPLOYMENT.md) antes de tener certificado.
server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    client_max_body_size 25m;

    location /api/ {
        proxy_pass http://backend_api/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health {
        proxy_pass http://backend_api/health;
        proxy_set_header Host $host;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
